{
  "name": "xinyuexia",
  "private": true,
  "version": "0.1.0",
  "description": "月下写作桌面版",
  "author": "OpenAI Codex",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "electron electron/main.cjs",
    "desktop:dist": "npm run build && cross-env XINYUEXIA_LOAD_DIST=1 electron electron/main.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "node scripts/lint-with-debt-gate.cjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,css,md}\"",
    "check": "tsc --noEmit",
    "check:electron": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/appIconService.cjs && node --check electron/startupExperience.cjs && node --check electron/windowStateStore.cjs && node --check electron/windowBounds.cjs && node --check electron/cosService.cjs && node --check electron/modelRequestService.cjs && node --check scripts/electron-window-state-smoke.mjs",
    "check:launcher": "node --check launch-xinyuexia.mjs",
    "check:source-size": "node scripts/check-source-size.cjs",
    "check:refactor-debt": "node scripts/check-refactor-debt.cjs && node scripts/check-extracted-scope-bridges.cjs",
    "scan:dist-secrets": "node scripts/check-dist-secrets.cjs dist",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "node scripts/electron-smoke.mjs",
    "test:window-state": "node scripts/electron-window-state-smoke.mjs",
    "test:routes": "node scripts/electron-route-smoke.mjs",
    "verify:quick": "npm run lint && npm run check && npm run check:source-size && npm run check:refactor-debt && npm run check:electron && npm run check:launcher && npm run test:run",
    "verify": "npm run verify:quick && npm run build && npm run scan:dist-secrets",
    "verify:desktop": "npm run verify && npm run test:e2e && npm run test:routes",
    "pack:win": "npm run verify:desktop && electron-builder --win portable"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "cross-env": "^7.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.7"
  },
  "allowScripts": {
    "electron@43.1.0": true,
    "esbuild@0.27.7": true
  },
  "build": {
    "appId": "com.yuexia.writer.desktop",
    "productName": "月下写作",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.*",
      "!electron/**/*.spec.*",
      "!electron/**/__fixtures__/**",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/app-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
